{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n \"api,app\" -c \"cyan,green\" \"pnpm --filter @workspace/api-server run dev:local\" \"pnpm --filter @workspace/resume-ai run dev:local\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @workspace/api-server run start",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @workspace/db run push",
    "prettier": "prettier --write ."
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
