## API server config
## Copy to `.env` and fill values.

# ─── Server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database (Postgres) ────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_builder

# ─── Supabase (Auth) ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Provider (OpenRouter) ───────────────────────────────────────
# Get an API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# OpenRouter Models (Optional - defaults used if empty)
OPENROUTER_MODEL_FREE=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_MODEL_PRO=anthropic/claude-3.5-sonnet

# Fallback Models (Optional)
OPENROUTER_MODEL_FREE_FALLBACK=google/gemini-pro-1.5
OPENROUTER_MODEL_PRO_FALLBACK=openai/gpt-4o

# Site metadata for OpenRouter (Optional)
SITE_URL=https://resume-ai.app

# ─── Razorpay (Payments) ────────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── CORS (Production) ──────────────────────────────────────────────
# Comma-separated list of allowed origins (required in production)
# CORS_ORIGINS=https://your-app.com,https://admin.your-app.com

# ─── Development ────────────────────────────────────────────────────
# Bypass auth for local dev (NEVER in production)
# DEV_BYPASS_AUTH=true
